# Required in every deployed environment. Production startup rejects missing,
# placeholder, or insecure values before serving traffic.
NEON_CONNECTION_STRING=postgresql://user:password@host/database?sslmode=require
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# Public application origin. This must also be present during the production
# build so prerendered canonical and social URLs use the deployed domain.
PERCH_PUBLIC_URL=http://localhost:2222

# Google OAuth (set all three together to enable the button)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:2222/auth/google

# Optional dedicated realtime signing secret (32+ characters).
# Leave unset to reuse NUXT_SESSION_PASSWORD.
REALTIME_SECRET=

# Transactional email (both are required in production for verification and
# account recovery)
RESEND_API_KEY=
RESEND_FROM="Perch <no-reply@useperch.xyz>"
# Signs one-time visitor return links. Use a different 32+ character secret
# from the account session and realtime secrets.
VISITOR_REPLY_SECRET=
# Stable HMAC key for visitor email suppression/dedup hashes. Use a different
# 32+ character secret and do not rotate it during ordinary key rotation.
VISITOR_EMAIL_HASH_SECRET=
# Keep feature exposure off until its secrets and privacy review are complete.
VISITOR_REPLY_EMAIL_FEATURE_ENABLED=false
# Keep delivery off until visitor-email processing is approved and the
# production delivery worker and provider webhook are registered.
VISITOR_REPLY_EMAIL_DELIVERY_ENABLED=false
# Required before visitor reply delivery is enabled. In Resend, subscribe this
# endpoint to email.bounced and email.complained:
# https://staging.useperch.xyz/api/webhooks/resend
# https://useperch.xyz/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Bachs subscriptions (set all three together). Use sandbox for portfolio demos,
# including on the production domain; the app still enforces production security.
# BACHS_ENV=sandbox requires a sk_sandbox_ key and its sandbox webhook secret.
# Webhook URL (same path as Schedra):
# https://staging.useperch.xyz/api/webhooks/bachs
# https://useperch.xyz/api/webhooks/bachs
BACHS_ENV=
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# Fail-closed gate for starting new paid checkouts. Keep false until sandbox
# acceptance, live product verification, webhook reconciliation, and support
# procedures are complete. Existing subscriptions and webhooks still operate.
PERCH_BILLING_CHECKOUT_ENABLED=false

# Signed image uploads (set all three together)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Operations and observability
PERCH_ADMIN_EMAILS=
SENTRY_DSN=
# Browser error reporting is independently opt-in because this value is public.
NUXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
NUXT_PUBLIC_SENTRY_ENVIRONMENT=staging

# Landing-page demo widget
NUXT_PUBLIC_DEMO_SITE_ID=

# Local webhook receiver testing only. Never enable this in staging or
# production; production startup rejects it.
PERCH_WEBHOOK_ALLOW_LOCALHOST=false
# Durable outbound conversation webhook delivery. Leave false until the
# workspace data-egress policy and production endpoints have been approved.
PERCH_WEBHOOK_DELIVERY_ENABLED=false
