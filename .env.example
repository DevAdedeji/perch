# Required in every deployed environment. Production startup rejects missing,
# placeholder, or insecure values before serving traffic.
NEON_CONNECTION_STRING=postgresql://user:password@host/database?sslmode=require
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# Public application origin. This must also be present during the production
# build so prerendered canonical and social URLs use the deployed domain.
PERCH_PUBLIC_URL=http://localhost:2222

# Google OAuth (set all three together to enable the button)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:2222/auth/google

# Optional dedicated realtime signing secret (32+ characters).
# Leave unset to reuse NUXT_SESSION_PASSWORD.
REALTIME_SECRET=

# Transactional email (both are required in production for verification and
# account recovery)
RESEND_API_KEY=
RESEND_FROM="Perch <no-reply@useperch.xyz>"

# Bachs subscriptions (set both together). Use sandbox keys outside production.
# Webhook URL (same path as Schedra):
# https://staging.useperch.xyz/api/webhooks/bachs
# https://useperch.xyz/api/webhooks/bachs
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# Signed image uploads (set all three together)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Operations and observability
PERCH_ADMIN_EMAILS=
SENTRY_DSN=

# Landing-page demo widget
NUXT_PUBLIC_DEMO_SITE_ID=
